---
---

<style>
  .signup-form {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  .signup-form input {
    flex: 1;
    min-width: 200px;
  }
</style>

<form
  action="https://formspree.io/f/xvzlbkqj"
  method="POST"
  class="signup-form"
>
  <input type="hidden"
    name="_subject"
    value="New signup — damdug.com" />
  <input type="hidden"
    name="_next"
    value="https://www.damdug.com/confirm" />
  <input
    type="email"
    name="email"
    placeholder="your@email.com"
    required
    class="form-input"
  />
  <button type="submit" class="btn btn--accent">
    Get Access
  </button>
</form>
