---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home" description="Douglas M. Galloway — Systems thinker and builder. Frameworks developed from practice, made available because they're useful beyond my own context.">
<style>
  footer { margin-top: 0 !important; }
</style>
  <section class="section">
    <div class="container">
      <p class="label" style="margin-bottom: var(--space-md);">DOUGLAS M. GALLOWAY</p>
      <p style="margin-bottom: var(--space-md); color: var(--text-tertiary); font-size: 0.875rem;">For people building something real who keep running into the same ceiling.</p>
      <h1 class="cursor">Systems over shortcuts.</h1>
      <p style="margin-top: var(--space-lg); max-width: 60ch;">
        I build systems — for organizations, for teams, for myself. The lens doesn't change with the scale.
      </p>
      <div style="margin-top: var(--space-xl); display: flex; flex-direction: column; gap: var(--space-md); max-width: 480px;">
        <a href="https://calendly.com/damdug/30min" target="_blank" rel="noopener noreferrer" class="btn btn--accent">
          Ready to work on it? Start with a free 30-minute call →
        </a>
        <a href="/frameworks" style="font-size: 0.875rem; color: var(--text-tertiary);">Explore the frameworks →</a>
      </div>
    </div>
  </section>
</BaseLayout>
